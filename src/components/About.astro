---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p data-reveal class="mb-3 font-display text-sm font-semibold tracking-[0.25em] text-brand uppercase">
          {t.about.title}
        </p>
        <h2 data-reveal class="font-display text-3xl font-bold sm:text-4xl">
          {t.hero.eyebrow}
        </h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-muted">
        <p data-reveal>{t.about.text1}</p>
        <p data-reveal>{t.about.text2}</p>
      </div>
    </div>

    <dl data-reveal-group class="mt-16 grid gap-6 sm:grid-cols-3">
      {
        t.about.stats.map((stat) => (
          <div class="rounded-lg border border-line bg-surface p-8 text-center">
            <dd class="font-display text-4xl font-bold text-brand">{stat.value}</dd>
            <dt class="mt-2 text-sm tracking-wide text-muted uppercase">{stat.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
