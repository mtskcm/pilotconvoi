---
import { Image } from 'astro:assets';
import logoWide from '../assets/logo/logo-wide-white-text.png';
import { useTranslations, type Lang } from '../i18n';
import { COMPANY } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-6">
    <a href="#top" aria-label={COMPANY.name}>
      <Image src={logoWide} alt={COMPANY.name} class="h-8 w-auto opacity-80" widths={[320, 480]} sizes="218px" />
    </a>
    <p class="text-sm text-muted">
      {COMPANY.address} · <a href={`tel:${COMPANY.phone}`} class="transition-colors hover:text-brand">{COMPANY.phoneDisplay}</a> ·
      <a href={`mailto:${COMPANY.email}`} class="transition-colors hover:text-brand">{COMPANY.email}</a>
    </p>
    <p class="text-sm text-muted/80">
      {COMPANY.legalName} · IČO: {COMPANY.ico} · DIČ: {COMPANY.dic} · IČ DPH: {COMPANY.icdph}
    </p>
    <p class="text-sm text-muted/70">
      © {year}
      {COMPANY.name}. {t.footer.rights}
    </p>
    <p class="text-sm text-muted/70">
      {t.footer.credit}
      <a
        href="https://mtskcm.github.io"
        target="_blank"
        rel="noopener"
        class="font-medium text-muted transition-colors hover:text-brand">Matúš Kačmár</a
      >
    </p>
  </div>
</footer>
