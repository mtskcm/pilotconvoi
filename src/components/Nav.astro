---
import { Image } from 'astro:assets';
import logoWide from '../assets/logo/logo-wide-white-text.png';
import { languages, locales, localePath, useTranslations, type Lang } from '../i18n';
import { COMPANY, GALLERY } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: '#services', label: t.nav.services },
  { href: '#about', label: t.nav.about },
  { href: '#routes', label: t.nav.routes },
  ...(GALLERY.length > 0 ? [{ href: '#gallery', label: t.nav.gallery }] : []),
  { href: '#contact', label: t.nav.contact },
];
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="#top" class="shrink-0" aria-label={COMPANY.name}>
      <Image src={logoWide} alt={COMPANY.name} class="h-8 w-auto sm:h-9" widths={[320, 480]} sizes="245px" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-display text-sm font-semibold tracking-wide text-fg/80 uppercase transition-colors hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={`tel:${COMPANY.phone}`}
        class="hidden items-center gap-2 rounded-md bg-brand px-4 py-2 font-display text-sm font-bold tracking-wide text-ink uppercase transition-colors hover:bg-brand-strong sm:inline-flex"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.36 2.3.56 3.6.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.56 3.58a1 1 0 0 1-.25 1.02L6.6 10.8Z"
          ></path>
        </svg>
        {t.nav.call}
      </a>

      <details class="group relative" data-lang-menu>
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-line px-3 py-2 font-display text-sm font-semibold text-fg/80 uppercase transition-colors hover:border-brand hover:text-brand [&::-webkit-details-marker]:hidden"
          aria-label={t.nav.language}
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
          </svg>
          {lang}
          <svg class="h-3 w-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 mt-2 w-44 overflow-hidden rounded-md border border-line bg-surface-2 py-1 shadow-xl">
          {
            locales.map((l) => (
              <li>
                <a
                  href={localePath(l)}
                  data-lang-link
                  aria-current={l === lang ? 'true' : undefined}
                  class:list={[
                    'block px-4 py-2 text-sm transition-colors hover:bg-surface hover:text-brand',
                    l === lang ? 'font-semibold text-brand' : 'text-fg/80',
                  ]}
                >
                  {languages[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>

      <button
        type="button"
        data-menu-toggle
        class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-line text-fg lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
      >
        <svg data-icon-open class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg data-icon-close class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-ink/95 backdrop-blur-md lg:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-3 sm:px-6" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-menu-link
            class="border-b border-line/50 py-3 font-display font-semibold tracking-wide text-fg/90 uppercase transition-colors last:border-0 hover:text-brand"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={`tel:${COMPANY.phone}`}
        class="mt-3 mb-1 inline-flex items-center justify-center gap-2 rounded-md bg-brand px-4 py-3 font-display font-bold tracking-wide text-ink uppercase"
      >
        {t.nav.call} · {COMPANY.phoneDisplay}
      </a>
    </nav>
  </div>
</header>
