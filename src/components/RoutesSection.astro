---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="routes" class="relative bg-surface py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p data-reveal class="mb-3 font-display text-sm font-semibold tracking-[0.25em] text-brand uppercase">
      {t.routes.title}
    </p>
    <h2 data-reveal class="max-w-3xl font-display text-[clamp(1.4rem,6.5vw,1.875rem)] font-bold sm:text-4xl">
      {t.routes.subtitle}
    </h2>

    <div class="mt-14 grid items-center gap-12 lg:grid-cols-2">
      <ul data-reveal-group class="space-y-4">
        {
          t.routes.corridors.map((corridor) => (
            <li class="flex items-center gap-4 rounded-lg border border-line bg-surface-2 px-6 py-5">
              <svg class="h-6 w-6 shrink-0 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <p class="font-display font-semibold">{corridor.route}</p>
                <p class="text-sm text-muted">{corridor.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <!-- abstraktný diagram koridorov: SK ako hub, spoke do PL / UA / HU / AT -->
      <div data-reveal class="rounded-lg border border-line bg-ink/60 p-6">
        <svg viewBox="0 0 560 360" class="h-auto w-full" role="img" aria-label={t.routes.title}>
          <defs>
            <radialGradient id="hub-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ff8319" stop-opacity="0.35"></stop>
              <stop offset="100%" stop-color="#ff8319" stop-opacity="0"></stop>
            </radialGradient>
          </defs>

          <circle cx="280" cy="170" r="90" fill="url(#hub-glow)"></circle>

          <g stroke="#ff8319" stroke-width="3" fill="none" stroke-linecap="round">
            <path data-draw d="M170 70 Q 200 130 280 170"></path>
            <path data-draw d="M280 170 Q 380 120 470 120"></path>
            <path data-draw d="M280 170 Q 360 240 396 288"></path>
            <path data-draw d="M280 170 Q 190 240 128 278"></path>
          </g>

          <g font-family="Chakra Petch, sans-serif" font-weight="600" text-anchor="middle">
            <g>
              <circle cx="170" cy="70" r="9" fill="#1b1b21" stroke="#ff8319" stroke-width="2.5"></circle>
              <text x="170" y="44" fill="#f5f5f4" font-size="18">PL</text>
            </g>
            <g>
              <circle cx="470" cy="120" r="9" fill="#1b1b21" stroke="#ff8319" stroke-width="2.5"></circle>
              <text x="470" y="94" fill="#f5f5f4" font-size="18">UA</text>
            </g>
            <g>
              <circle cx="396" cy="288" r="9" fill="#1b1b21" stroke="#ff8319" stroke-width="2.5"></circle>
              <text x="396" y="326" fill="#f5f5f4" font-size="18">HU</text>
            </g>
            <g>
              <circle cx="128" cy="278" r="9" fill="#1b1b21" stroke="#ff8319" stroke-width="2.5"></circle>
              <text x="128" y="316" fill="#f5f5f4" font-size="18">AT</text>
            </g>
            <g>
              <circle cx="280" cy="170" r="14" fill="#ff8319"></circle>
              <circle cx="280" cy="170" r="5" fill="#0c0c0e"></circle>
              <text x="280" y="140" fill="#ff8319" font-size="20">SK</text>
            </g>
          </g>
        </svg>
      </div>
    </div>

    <p data-reveal class="mt-12 max-w-2xl text-lg text-muted">
      {t.routes.note}
    </p>
  </div>
</section>
