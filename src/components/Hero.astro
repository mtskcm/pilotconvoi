---
import { Image } from 'astro:assets';
import pilotCars from '../assets/photos/pilot-cars-night.jpg';
import { useTranslations, type Lang } from '../i18n';
import { COMPANY } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const badges = [t.hero.badge247, t.hero.badgeEu, t.hero.badgePermits];
---

<section id="top" class="relative flex min-h-svh items-center overflow-hidden">
  <!-- podklad: fotka pilotných vozidiel + tmavé prekrytie a oranžový glow -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <Image
      src={pilotCars}
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-center"
      widths={[768, 1280, 1536]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-ink/50"></div>
    <!-- stmavenie zľava, nech je text čitateľný aj nad svetlými časťami fotky -->
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/65 to-ink/25"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
    <!-- glow cez radial-gradient (nie blur filter — ten na mobiloch vykresľuje hranaté okraje) -->
    <div
      data-glow
      class="absolute -bottom-52 -left-32 h-[40rem] w-[40rem] bg-[radial-gradient(closest-side,rgba(255,131,25,0.18),transparent)]"
    >
    </div>
    <!-- výstražné šrafovanie ako jemný akcent na spodku hero -->
    <div
      class="absolute inset-x-0 bottom-0 h-2 bg-[repeating-linear-gradient(-45deg,var(--color-brand)_0_16px,transparent_16px_32px)] opacity-60"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-4 pt-28 pb-20 sm:px-6">
    <p data-reveal class="mb-4 font-display text-sm font-semibold tracking-[0.25em] text-brand uppercase">
      {t.hero.eyebrow}
    </p>
    <!-- plynulá veľkosť písma: aj najdlhšie slová (PL/DE) sa zmestia celé, bez delenia -->
    <h1
      data-reveal
      class="max-w-4xl font-display text-[clamp(1.5rem,7.5vw,2.25rem)] leading-tight font-bold uppercase sm:text-5xl md:text-6xl lg:text-7xl"
    >
      {t.hero.titleTop}
      <span class="text-brand">{t.hero.titleAccent}</span>
    </h1>
    <p data-reveal class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
      {t.hero.subtitle}
    </p>

    <div data-reveal class="mt-10 flex flex-wrap items-center gap-4">
      <a
        href={`tel:${COMPANY.phone}`}
        class="inline-flex items-center gap-2.5 rounded-md bg-brand px-7 py-3.5 font-display text-base font-bold tracking-wide text-ink uppercase shadow-lg shadow-brand/25 transition-all hover:bg-brand-strong hover:shadow-brand/40"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.36 2.3.56 3.6.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.56 3.58a1 1 0 0 1-.25 1.02L6.6 10.8Z"
          ></path>
        </svg>
        {t.hero.ctaCall}
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-md border border-line px-7 py-3.5 font-display text-base font-semibold tracking-wide text-fg uppercase transition-colors hover:border-brand hover:text-brand"
      >
        {t.hero.ctaWrite}
      </a>
    </div>

    <ul data-reveal-group class="mt-12 flex flex-wrap gap-3">
      {
        badges.map((badge) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/60 px-4 py-2 text-sm font-medium text-fg/90 backdrop-blur">
            <span class="h-1.5 w-1.5 rounded-full bg-brand" aria-hidden="true" />
            {badge}
          </li>
        ))
      }
    </ul>
  </div>

  <a
    href="#services"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 text-muted transition-colors hover:text-brand"
    aria-label={t.hero.scroll}
  >
    <svg class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 5v14m0 0-6-6m6 6 6-6"></path>
    </svg>
  </a>
</section>
